#!/usr/bin/env warp
# "Deuterium" by XorDev (@XorDev), a tweet-sized shader, ported as a WGSL fragment shader:
# https://x.com/XorDev/status/2119942338831388973
# license: not stated in the post, so all rights stay with the author
# Twenty steps march a ray from the camera. At each step seven octaves of cosine turbulence bend the point, the point
# is pushed out by the ray's start, and the step length is the distance to a wobbling shell at depth 5; each step adds
# a hue cycling with depth, brighter the closer the shell (1/d²). tanh tone-maps the sum. XorDev's shorthand: f3 vec3,
# f4 vec4, ab abs, nor normalize, C gl_FragCoord, R the resolution, T the time, O the color. $time and $size are
# paint's values, read each frame
deuterium = shader {
	@fragment fn main(@builtin(position) at: vec4f) -> @location(0) vec4f {
		// gl_FragCoord counts up from the bottom; a paint pixel counts down from the top
		let fc = vec3f(at.x, $size.y - at.y, at.z);
		// nor(C.rgb*2-R.xyy): the ray's direction, its z the fragment's depth twice less the height
		let ray = normalize(fc * 2.0 - vec3f($size.x, $size.y, $size.y));
		var c = vec3f(.0);
		var p = vec3f(.0);
		var z = .0;
		var d = .0;
		var color = vec4f(.0);
		// i++ < 20, so the body sees i = 1 … 20
		for (var step = 0; step < 20; step++) {
			let i = f32(step) + 1.0;
			p = z * ray + vec3f(i * .2);
			c = p;
			// d++ < 7: the turbulence's octaves d = 1 … 7
			for (var octave = 1; octave <= 7; octave++) {
				p += .3 * cos(p.zxy * f32(octave) + vec3f($time));
			}
			// the outer loop's step: p+=c, z+=d=…, O+=…
			p += c;
			d = .3 * abs(z - 5.0 + dot(cos(p), sin(p.yzx * .6 + vec3f($time)))) + .1;
			z += d;
			color += (cos(vec4f(z) + vec4f(9.0, 4.0, 5.0, .0)) + vec4f(1.0)) / d / d;
		}
		return vec4f(tanh(color.rgb / 60.0), 1.0);
	}
}
# each frame of the window until it closes (headless: one frame, as a PNG)
on frame: paint(deuterium)
on key.Escape: exit()